<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Dark Mode. -->
    <style name="Base.Theme.FizikaTest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/roboto</item>
        <item name="fontFamily">@font/roboto</item>
        <item name="android:windowBackground">@color/phys_background_dark</item>
        <item name="android:textColorPrimary">@color/phys_on_surface_dark</item>
        <item name="android:statusBarColor">@color/phys_toolbar_dark</item>
        <item name="android:navigationBarColor">@color/phys_background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorPrimary">@color/phys_primary_dark</item>
        <item name="colorOnPrimary">@color/phys_on_surface_dark</item>
        <item name="colorSurface">@color/phys_surface_dark</item>
        <item name="colorOnSurface">@color/phys_on_surface_dark</item>
        <item name="colorOutline">@color/phys_outline_dark</item>
        <item name="colorPrimaryContainer">@color/phys_toolbar_dark</item>
        <item name="colorSurfaceVariant">@color/phys_surface_variant_dark</item>
    </style>

    <style name="StyleTestCorrectAnswer">
        <item name="android:background">@drawable/style_test_correct_answer</item>
        <item name="android:textColor">@color/correct_text_dark</item>
    </style>
    <style name="StyleTestWrongAnswer">
        <item name="android:background">@drawable/style_test_wrong_answer</item>
        <item name="android:textColor">@color/wrong_text_dark</item>
    </style>
    <style name="StyleTestDefaultAnswer">
        <item name="android:background">@drawable/style_test_default_answer</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
